<Window x:Class="Widger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Widger"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/" 
        xmlns:comp="clr-namespace:Widger.Components"
        Icon="/Assets/Images/icon.png"
        WindowStyle="None"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        MinHeight="500" MinWidth="500"
        Title="MainWindow" Height="650" Width="900">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                  CornerRadius="0"
                  CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackground}" CornerRadius="0" BorderBrush="{DynamicResource ButtonColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Style="{DynamicResource TitleBar}" MouseDown="Titlebar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <svgc:SvgViewbox Source="/Assets/Images/logo_widger.svg" Height="20" Margin="0,0,10,0" />
                    <Button HorizontalAlignment="Right" Style="{DynamicResource Button_Link}" Click="AboutApp_Click" ToolTip="About app">
                        <svgc:SvgViewbox Source="Assets/Images/faqIcon.svg" Width="15" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Margin="0,0,10,0">
                    <Button x:Name="ButtonMinimize" Style="{DynamicResource TitleBar_Button}" Click="ButtonMinimize_Click">
                        <Image Style="{DynamicResource Title_Minimize}"/>
                    </Button>
                    <Button x:Name="ButtonMaximize" Style="{DynamicResource TitleBar_Button}" Click="ButtonMaximize_Click">
                        <Image Style="{DynamicResource Title_Maximize}"/>
                    </Button>
                    <Button x:Name="ButtonClose" Style="{DynamicResource TitleBar_ButtonClose}" Click="ButtonClose_Click">
                        <Image Style="{DynamicResource Title_Close}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Create new widget" HorizontalAlignment="Left" VerticalAlignment="Center" Click="CreateWidget_Click" Cursor="Hand" />

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="WidgetsContent" Orientation="Vertical" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <comp:Toast Grid.Row="1" x:Name="MyToast" Padding="10" />
            <Grid Grid.Row="1" x:Name="Modal_Content" />
        </Grid>
    </Border>
</Window>
